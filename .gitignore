# ============================================================
# P2P Codex Edition — .gitignore
# Loại: bytecode, trạng thái cục bộ, dữ liệu tool, artifact tạm
# Không loại: source, governance, docs, tests, reports, candidates
# ============================================================

# --- Bytecode Python (tự sinh lại được) ---
__pycache__/
*.py[cod]
*.pyo
.coverage
.pytest_cache/

# --- Trạng thái cục bộ của máy (không chia sẻ qua Git) ---
.p2p/state/
.p2p/edge-runs/
.p2p/install-backups/
.p2p/evals/runs/
.p2p/evals/*.json
.p2p/gates/
.p2p/approvals/
.p2p/project-profile.json
.p2p/usage.json

# --- Dữ liệu tool điều hướng cục bộ ---
.anvien/

# --- Artifact tạm ---
.tmp/

# --- Môi trường / bí mật ---
.env
*.key
*.pem

# anvien:start
# Anvien local index and generated AI context
.gitignore
.anvien/
AGENTS.md
CLAUDE.md

# Agent/editor local state used by Anvien integrations
.claude/
.codex/
.agents/
.grok/
.claude-flow/
.claude-plugin/
.history/
.swarm/
.codex-tmp/
.tmp/
undefined/
local_docs/

# Local Anvien launcher/runtime generated artifacts
anvien-launcher/web-dist/
anvien-launcher/AnvienLauncher.exe
anvien-launcher/server-bundle/
anvien-launcher/logs/
# anvien:end
