# CloudDesk pilot configuration template.
#
#   cp .env.example .env      # then fill in the two secrets
#   chmod 600 .env            # never commit .env
#
# .env is deployment state, not project source. It must stay out of Git.

# --- identity of the public endpoint ---------------------------------------
# Stable public origin WITHOUT the /mcp suffix. Pins OAuth issuer, audience,
# resource and all discovery URLs so a spoofed Host header cannot move them.
# This is the upstream variable name, and it is the same one the empirically
# tested launcher (start-server.sh, PILOT_SERVER_URL) passes to the server.
CODING_TOOLS_MCP_SERVER_URL=https://mcp.example.com

# --- secrets (generate, do not reuse, do not commit) ------------------------
# Password the operator types on the OAuth authorize page.
#   python3 -c 'import secrets;print(secrets.token_urlsafe(24))'
CODING_TOOLS_MCP_OAUTH_PASSWORD=

# Stable HS256 signing key, hex-encoded. Without it, issued tokens do not
# survive a server restart and ChatGPT must re-authorize every time.
#   python3 -c 'import secrets;print(secrets.token_bytes(32).hex())'
CODING_TOOLS_MCP_OAUTH_TOKEN_SECRET=

# --- runtime posture --------------------------------------------------------
CODING_TOOLS_MCP_PORT=8765

# safe    = strictest; network-looking commands, shell expansion and inline
#           scripts all require permission (and request_permissions currently
#           answers ELICITATION_UNSUPPORTED, so those calls simply fail).
# trusted = local-development posture. Recommended for this pilot: network,
#           shell expansion and inline scripts allowed; secret filtering and
#           destructive-command checks stay ON.
# dangerous = permission gates OFF. Only inside an isolated container/VM.
CODING_TOOLS_MCP_PERMISSION_MODE=trusted

# Leave empty. A server-to-server MCP connector runtime sends no Origin header
# and needs none. Set an exact origin only if a browser-based MCP client must
# reach this endpoint, e.g. CODING_TOOLS_MCP_ALLOWED_ORIGINS=https://chatgpt.com
CODING_TOOLS_MCP_ALLOWED_ORIGINS=

# Bearer-token alternative (for MCP clients that CAN set a static header, e.g.
# Claude Desktop / Cursor). Regular ChatGPT Web cannot, so keep oauth for it.
# CODING_TOOLS_MCP_AUTH_MODE=bearer
# CODING_TOOLS_MCP_AUTH_TOKEN=

# --- image build (Docker path only) -----------------------------------------
# Consumed as a Docker build ARG that pins the PyPI version installed into the
# image. It is NOT a runtime variable: the server does not read it, so changing
# it requires a rebuild (docker compose build --no-cache).
CODING_TOOLS_MCP_VERSION=0.3.0

# --- resource caps ----------------------------------------------------------
CLOUDDESK_MEM_LIMIT=2g
CLOUDDESK_CPUS=1.5
