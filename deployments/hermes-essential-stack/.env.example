# Generated local secrets are written to .env by scripts/hermes_essential_stack_guard.py init.
# Never commit the generated .env.

API_SERVER_KEY=__GENERATE_API_SERVER_KEY__
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=p2p
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=__GENERATE_DASHBOARD_PASSWORD__
HERMES_DASHBOARD_BASIC_AUTH_SECRET=__GENERATE_DASHBOARD_SECRET__
HERMES_PASSWORD=__GENERATE_WORKSPACE_PASSWORD__

# Provider keys: set only the provider(s) actually used by Hermes.
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# GenieX stays opt-in and local-only. When enabled, GENIEX_BASE_URL must point
# to a loopback/host bridge endpoint ending in /v1, and GENIEX_MODEL must be an
# explicit working model id accepted by /v1/chat/completions. Do not rely on
# /v1/models auto-discovery because some GenieX builds have returned precision-
# suffixed ids that chat/completions does not accept.
P2P_ENABLE_GENIEX=NO
GENIEX_BASE_URL=
GENIEX_MODEL=

# Hindsight stays disabled until both lines below are intentionally set.
P2P_ENABLE_HINDSIGHT=NO
HINDSIGHT_API_KEY=

# Opik Cloud pilot. Disabled by default. The safe default exports only
# operational metadata (model/provider/tool names, timing, status, token usage,
# and opaque hashed correlation ids). Turning content capture on may export
# prompts, assistant responses, tool args/results and subagent summaries; that
# is a separate privacy Owner Gate and must never be enabled casually.
P2P_ENABLE_OPIK=NO
P2P_OPIK_CAPTURE_CONTENT=NO
OPIK_URL_OVERRIDE=https://www.comet.com/opik/api
OPIK_API_KEY=
OPIK_WORKSPACE=
OPIK_PROJECT_NAME=p2p-hermes
OPIK_ENVIRONMENT=development
OPIK_ANALYTICS_ENABLE=false

# Bounded Repomix context output.
REPOMIX_TOKEN_BUDGET=200000
