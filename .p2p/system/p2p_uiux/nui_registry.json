  "routing_rules": [
    {
      "id": "material-baseline",
      "disposition": "REQUIRED",
      "reason": "Every material UI task needs product intent, user/task semantics, information architecture, interaction/state closure, and evidence-bound completion.",
      "any_signals": [
        "material",
        "new_surface",
        "workflow",
        "navigation",
        "visual_redesign",
        "design_system",
        "high_fidelity"
      ],
      "skills": [
        "modeling-product-intent",
        "modeling-users-and-tasks",
        "architecting-information",
        "designing-task-flows",
        "designing-interactions",
        "modeling-component-semantics",
        "modeling-component-states",
        "designing-empty-loading-error-states",
        "directing-visual-hierarchy",
        "architecting-design-tokens",
        "adapting-responsive-layouts",
        "designing-accessible-interfaces",
        "critiquing-user-experience",
        "critiquing-visual-design",
        "verifying-runtime-ui-behavior",
        "validating-rendered-perception",
        "gating-ui-completion"
      ]
    },
    {
      "id": "professional-workspace",
      "disposition": "EXPECTED",
      "reason": "Operational, manager, reconciliation, or dense work needs broad workspace closure and stable comparison surfaces.",
      "any_signals": [
        "operational",
        "manager_visibility",
        "dense_data",
        "reconciliation",
        "exceptions",
        "professional_workspace",
        "audit_history"
      ],
      "skills": [
        "designing-desktop-windowed-workspaces",
        "designing-data-dense-interfaces",
        "designing-navigation",
        "designing-search",
        "inventorying-product-capabilities",
        "registering-ui-actions",
        "proving-interface-reachability",
        "covering-product-scenarios",
        "critiquing-functional-completeness",
        "designing-latency-and-progressive-feedback",
        "designing-real-time-updates",
        "designing-offline-degraded-experiences",
        "documenting-design-decisions",
        "governing-design-systems"
      ]
    },
    {
      "id": "consequential-decisions",
      "disposition": "REQUIRED",
      "reason": "Financial, destructive, privacy, security, or consequential workflows require consequence, reversibility, authority, confirmation, recovery, and independent safety critique.",
      "any_signals": [
        "high_impact",
        "financial",
        "destructive",
        "privacy",
        "security",
        "medical",
        "autonomous_action"
      ],
      "skills": [
        "designing-high-stakes-decisions",
        "designing-financial-transaction-ui",
        "designing-permissions-and-consent",
        "designing-privacy-sensitive-interfaces",
        "designing-authentication-and-passkeys",
        "critiquing-human-factors-and-safety",
        "critiquing-security-and-privacy"
      ]
    },
    {
      "id": "consumer-visual-direction",
      "disposition": "EXPECTED",
      "reason": "Materially open consumer or narrative visual work benefits from divergent directions before selecting a design language.",
      "any_signals": [
        "visual_redesign",
        "visual_ambition_open",
        "consumer",
        "narrative",
        "story",
        "game"
      ],
      "skills": [
        "exploring-aesthetic-directions",
        "composing-layouts",
        "crafting-typography",
        "crafting-color",
        "crafting-spacing-and-rhythm",
        "designing-motion",
        "writing-interface-copy",
        "preventing-generic-ui",
        "critiquing-aesthetic-adequacy",
        "designing-domain-native-signatures"
      ]
    },
    {
      "id": "game-surface",
      "disposition": "EXPECTED",
      "reason": "Game or controller-oriented interfaces need game surface and input/focus obligations instead of professional-workspace defaults.",
      "any_signals": [
        "game",
        "gamepad",
        "controller",
        "narrative"
      ],
      "skills": [
        "designing-game-hud-and-menus",
        "designing-gamepad-remote-focus",
        "critiquing-input-modality"
      ]
    },
    {
      "id": "accessibility-depth",
      "disposition": "REQUIRED",
      "reason": "Explicit accessibility, assistive technology, keyboard, low vision, cognitive, motion, or screen-reader risks require specialized inclusive obligations.",
      "any_signals": [
        "accessibility_heavy",
        "a11y",
        "keyboard",
        "screen_reader",
        "low_vision",
        "cognitive_accessibility",
        "reduced_motion"
      ],
      "skills": [
        "designing-keyboard-power-user-ux",
        "designing-cognitive-accessibility",
        "designing-low-vision-and-high-contrast",
        "designing-screen-reader-experiences",
        "designing-reduced-motion-and-photosensitivity",
        "critiquing-accessibility"
      ]
    },
    {
      "id": "human-ai",
      "disposition": "REQUIRED",
      "reason": "AI involvement requires uncertainty, provenance, agency, control, correction, and trust obligations.",
      "any_signals": [
        "ai",
        "human_ai",
        "agent",
        "streaming",
        "autonomous_action"
      ],
      "skills": [
        "designing-human-ai-interaction",
        "designing-ai-uncertainty-and-provenance",
        "designing-agent-autonomy-and-control",
        "designing-streaming-ai-responses",
        "designing-ai-feedback-and-correction",
        "critiquing-ai-trust-and-agency"
      ]
    },
    {
      "id": "reference-transfer",
      "disposition": "EXPECTED",
      "reason": "Named references inform mechanisms and authority, but require transfer to local product context rather than trade-dress cloning.",
      "any_signals": [
        "references",
        "named_reference",
        "external_pattern"
      ],
      "skills": [
        "researching-visual-references",
        "adapting-external-ui-patterns"
      ]
    },
    {
      "id": "runtime-evidence",
      "disposition": "REQUIRED",
      "reason": "Material UI completion must bind implementation claims to current rendered/runtime evidence when the host can provide it.",
      "any_signals": [
        "material",
        "high_fidelity",
        "runtime_render"
      ],
      "skills": [
        "binding-ui-evidence"
      ]
    }
  ],
  "p2p_extension": {
    "materiality_categories": [
      "new_surface",
      "navigation",
      "visual_redesign",
      "design_system",
      "consequential_interaction",
      "high_fidelity",
      "tiny_local_edit"
    ],
    "dispositions": [
      "REQUIRED",
      "EXPECTED",
      "OPTIONAL",
      "EXCLUDED",
      "UNKNOWN"
    ],
    "single_router": "p2p_uiux.router.classify_request",
    "canonical_quorum_denominator": 8,
    "canonical_quorum": "8/8",
    "optional_specialist": "p2p_aesthetica",
    "optional_specialist_in_denominator": false,
    "no_permission_grant": true,
    "c10_authority": "p2p-decision-trace/1",
    "c11_authority": "p2p-task-state/1",
    "c12_authority": "p2p-foreground-execution/1"
  }
