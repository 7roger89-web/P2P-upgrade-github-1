{
  "schema": "p2p-eval-registry/1",
  "version": "1.0.0",
  "governance_note": "Evidence-backed eval registry. NOT a router and NOT an orchestrator. FW04 (quality_intelligence) selects required verification per task from risk/mutation/capability evidence; existing execution machinery invokes the permitted mechanisms. Deterministic-first: records with reliability DETERMINISTIC are preferred whenever they can answer the question. Model-judgment records are explicitly INFERRED/REVIEW_JUDGMENT and never FACT.",
  "evals": [
    {
      "eval_id": "P2P-EVAL-PYTHON-COMPILE",
      "what": "All changed Python files parse without syntax error (py_compile).",
      "scope": "python_files",
      "input": "paths of changed .py files",
      "expected_signal": "compile exit code 0 per file",
      "reliability": "DETERMINISTIC",
      "dependencies": [],
      "cost_class": "CHEAP",
      "mutation_class": ["CONTENT_EDIT", "CODE_EDIT", "CROSS_SUBSYSTEM_EDIT"],
      "evidence_output": "compile_ok per file (bool) + hash of source",
      "failure_semantics": "EVAL_FAILED implies QUALITY_REJECTED on required class"
    },
    {
      "eval_id": "P2P-EVAL-UNIT-SUITE",
      "what": "Project/unit test suites pass on the post-change tree.",
      "scope": "tests",
      "input": "test module paths",
      "expected_signal": "unittest exit 0; per-case pass/fail",
      "reliability": "DETERMINISTIC",
      "dependencies": [],
      "cost_class": "MODERATE",
      "mutation_class": ["CODE_EDIT", "CROSS_SUBSYSTEM_EDIT", "SCHEMA_OR_PERMISSION_BOUNDARY"],
      "evidence_output": "suite summary (passed/failed/skipped) + case list",
      "failure_semantics": "required suite FAIL -> QUALITY_REJECTED; suite UNAVAILABLE -> EVAL_NOT_AVAILABLE (honest partial)"
    },
    {
      "eval_id": "P2P-EVAL-SCHEMA-CHECK",
      "what": "Changed JSON/YAML artifacts validate against their declared schema.",
      "scope": "config_artifacts",
      "input": "artifact path + schema path",
      "expected_signal": "schema validation OK per document",
      "reliability": "DETERMINISTIC",
      "dependencies": [],
      "cost_class": "CHEAP",
      "mutation_class": ["CONTENT_EDIT", "CODE_EDIT"],
      "evidence_output": "validation report per document",
      "failure_semantics": "FAIL -> QUALITY_REJECTED"
    },
    {
      "eval_id": "P2P-EVAL-STATIC-ANALYSIS",
      "what": "Static analysis (pyflakes/pycompile/AST checks) clean on changed modules.",
      "scope": "python_files",
      "input": "paths of changed .py files",
      "expected_signal": "zero diagnostics",
      "reliability": "DETERMINISTIC",
      "dependencies": [],
      "cost_class": "CHEAP",
      "mutation_class": ["CODE_EDIT", "CROSS_SUBSYSTEM_EDIT"],
      "evidence_output": "diagnostic count + lines",
      "failure_semantics": "FAIL -> QUALITY_REJECTED on required class"
    },
    {
      "eval_id": "P2P-EVAL-DIFF-BOUNDARY",
      "what": "Changed files respect declared mutation boundaries (no protected/generated files touched).",
      "scope": "files",
      "input": "changed file set + protected boundary list",
      "expected_signal": "no protected file in changed set",
      "reliability": "DETERMINISTIC",
      "dependencies": [],
      "cost_class": "CHEAP",
      "mutation_class": ["CONTENT_EDIT", "CODE_EDIT", "GENERATED_FILE_EDIT"],
      "evidence_output": "boundary violation list (empty = pass)",
      "failure_semantics": "violation -> QUALITY_REJECTED + POST_EXECUTION_MUTATION_AMBIGUITY"
    },
    {
      "eval_id": "P2P-EVAL-CONTENT-HASH",
      "what": "Content hashes of frozen fixtures unchanged (no unintended drift).",
      "scope": "fixtures",
      "input": "fixture paths + expected sha256",
      "expected_signal": "hash match per fixture",
      "reliability": "DETERMINISTIC",
      "dependencies": [],
      "cost_class": "CHEAP",
      "mutation_class": ["CONTENT_EDIT", "CODE_EDIT"],
      "evidence_output": "hash ledger (match/mismatch)",
      "failure_semantics": "mismatch -> QUALITY_REJECTED"
    },
    {
      "eval_id": "P2P-EVAL-CODE-IMPACT",
      "what": "Code-impact evidence contract: affected surface computed from change; UNKNOWN_IMPACT fails closed.",
      "scope": "repository",
      "input": "changed paths + project root",
      "expected_signal": "complete impact analysis (direct dependents, affected tests)",
      "reliability": "DETERMINISTIC",
      "dependencies": [],
      "cost_class": "MODERATE",
      "mutation_class": ["CODE_EDIT", "CROSS_SUBSYSTEM_EDIT"],
      "evidence_output": "impact contract (changed_symbols, direct_dependents, tests_affected, impact_unknown)",
      "failure_semantics": "IMPACT_UNKNOWN -> QUALITY_UNKNOWN (never 'no regression')"
    },
    {
      "eval_id": "P2P-EVAL-POLICY-VALIDATOR",
      "what": "Framework/policy validators (e.g. validate_p2p_development_framework) pass.",
      "scope": "governance",
      "input": "none",
      "expected_signal": "validator full-pass count as declared",
      "reliability": "DETERMINISTIC",
      "dependencies": [],
      "cost_class": "MODERATE",
      "mutation_class": ["CODE_EDIT", "CONTENT_EDIT", "CROSS_SUBSYSTEM_EDIT"],
      "evidence_output": "validator summary",
      "failure_semantics": "FAIL -> QUALITY_REJECTED"
    },
    {
      "eval_id": "P2P-EVAL-SECRET-SCAN",
      "what": "Secret scan (gitleaks) reports no new findings in changed scope.",
      "scope": "repository",
      "input": "changed paths",
      "expected_signal": "SECRET_INTRODUCED = 0",
      "reliability": "DETERMINISTIC",
      "dependencies": ["gitleaks binary"],
      "cost_class": "CHEAP",
      "mutation_class": ["CODE_EDIT", "CONTENT_EDIT"],
      "evidence_output": "scan report (findings in changed scope)",
      "failure_semantics": "new finding -> QUALITY_REJECTED"
    },
    {
      "eval_id": "P2P-EVAL-ROLE-REVIEW",
      "what": "Independent role-based review judgment of changed code (read-only).",
      "scope": "code_review",
      "input": "diff + task context",
      "expected_signal": "verdict QUALITY_VERIFIED/PARTIAL/UNKNOWN/REJECTED with reasons",
      "reliability": "REVIEW_JUDGMENT",
      "dependencies": ["independent verifier identity != executor"],
      "cost_class": "EXPENSIVE",
      "mutation_class": ["CROSS_SUBSYSTEM_EDIT", "SCHEMA_OR_PERMISSION_BOUNDARY"],
      "evidence_output": "review record (verifier, verdict, evidence)",
      "failure_semantics": "review UNKNOWN -> QUALITY_UNKNOWN; verifier unavailable when required -> INDEPENDENT_VERIFIER_UNAVAILABLE"
    },
    {
      "eval_id": "P2P-EVAL-DATA-INTERGITY",
      "what": "Data integrity and authorization boundary checks (genealogy projects: Supabase/RLS boundary read-only inspection if allowed).",
      "scope": "genealogy",
      "input": "migration/schema diffs (READ-ONLY analysis only)",
      "expected_signal": "no integrity/regression signals in diff evidence",
      "reliability": "DETERMINISTIC",
      "dependencies": [],
      "cost_class": "MODERATE",
      "mutation_class": ["SCHEMA_OR_PERMISSION_BOUNDARY"],
      "evidence_output": "diff analysis report (READ-ONLY)",
      "failure_semantics": "unknown -> QUALITY_UNKNOWN; never 'no regression' on unevidenced claims"
    },
    {
      "eval_id": "P2P-EVAL-BEHAVIORAL-TEST",
      "what": "Behavioral/UI/route/state tests (game/web projects).",
      "scope": "game_or_web",
      "input": "behavioral test definitions + fixtures",
      "expected_signal": "case pass per contract",
      "reliability": "DETERMINISTIC",
      "dependencies": ["test runtime"],
      "cost_class": "EXPENSIVE",
      "mutation_class": ["CROSS_SUBSYSTEM_EDIT", "CODE_EDIT"],
      "evidence_output": "case ledger (id/pass/weight)",
      "failure_semantics": "FAIL -> QUALITY_REJECTED; unavailable -> EVAL_NOT_AVAILABLE (honest partial)"
    }
  ]
}
