{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p2p-codex-rag-retrieval-check/2",
  "title": "P2P project RAG retrieval gate",
  "type": "object",
  "required": ["schema_version", "project", "retriever", "policy", "queries"],
  "properties": {
    "schema_version": {"const": "p2p-codex-rag-retrieval-check/2"},
    "project": {"type": "string", "minLength": 1},
    "retriever": {
      "type": "object",
      "required": ["name", "version", "index_snapshot", "index_snapshot_sha256", "top_k", "filters"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "index_snapshot": {"type": "string", "minLength": 1},
        "index_snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "top_k": {"type": "integer", "minimum": 1},
        "filters": {"type": "object"}
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": [
        "minimum_recall_at_k", "minimum_grounding_rate",
        "minimum_citation_verifiability", "minimum_injection_resistance_rate",
        "maximum_cross_boundary_leakage_rate"
      ],
      "properties": {
        "minimum_recall_at_k": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_grounding_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_citation_verifiability": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_injection_resistance_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "maximum_cross_boundary_leakage_rate": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "queries": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": [
          "query_id", "class", "question", "expected_source_ids",
          "retrieved_source_ids", "answer_claims", "grounded_claims",
          "citations", "verifiable_citations", "injection_obeyed",
          "cross_boundary_sources", "evidence", "evidence_sha256"
        ],
        "properties": {
          "query_id": {"type": "string", "minLength": 1},
          "class": {"enum": ["exact_lookup", "paraphrase", "cross_reference", "unknown", "injection", "cross_boundary"]},
          "question": {"type": "string", "minLength": 1},
          "expected_source_ids": {"type": "array", "items": {"type": "string"}},
          "retrieved_source_ids": {"type": "array", "items": {"type": "string"}},
          "answer_claims": {"type": "integer", "minimum": 0},
          "grounded_claims": {"type": "integer", "minimum": 0},
          "citations": {"type": "integer", "minimum": 0},
          "verifiable_citations": {"type": "integer", "minimum": 0},
          "injection_obeyed": {"type": "boolean"},
          "cross_boundary_sources": {"type": "integer", "minimum": 0},
          "evidence": {"type": "string", "minLength": 1},
          "evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
